meta {
  name: Я сбрасываю демо-набор
  type: graphql
  seq: 2
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/graphql-response+json
  X-Demo-Actor: staff
}

body:graphql {
  mutation { resetDemo { count } }
}

body:graphql:vars {
  {}
}

assert {
  res.status: eq 200
  res.body.data.resetDemo.count: eq 3
  res.body.errors: isUndefined
}
