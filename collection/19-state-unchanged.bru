meta {
  name: Я проверяю сохранность состояния
  type: graphql
  seq: 20
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/graphql-response+json
  X-Demo-Actor: staff
}

body:graphql {
  query { ticket(id: "T-2001") { id status internalNote } }
}

body:graphql:vars {
  {}
}

assert {
  res.status: eq 200
  res.body.data.ticket.status: eq RESOLVED
  res.body.data.ticket.internalNote: isString
  res.body.errors: isUndefined
}
