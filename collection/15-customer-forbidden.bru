meta {
  name: Я проверяю запрет смены статуса клиентом
  type: graphql
  seq: 16
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/graphql-response+json
  X-Demo-Actor: customer-a
}

body:graphql {
  mutation { changeStatus(input: { id: "T-2001", status: IN_PROGRESS }) { ticket { id status } userErrors { code } } }
}

body:graphql:vars {
  {}
}

assert {
  res.status: eq 200
  res.body.data.changeStatus: isNull
  res.body.errors[0].extensions.code: eq FORBIDDEN
}
