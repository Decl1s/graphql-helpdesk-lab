meta {
  name: Я проверяю границу first
  type: graphql
  seq: 22
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/graphql-response+json
  X-Demo-Actor: customer-a
}

body:graphql {
  query { tickets(first: 0) { id } }
}

body:graphql:vars {
  {}
}

assert {
  res.status: eq 200
  res.body.data.tickets: isNull
  res.body.errors[0].extensions.code: eq BAD_USER_INPUT
}
